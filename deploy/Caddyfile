# APP_DOMAIN comes from /opt/housemate/.env (e.g. housemate.example.com).
# Caddy fetches and renews the HTTPS certificate automatically.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		# Browsers only ever use HTTPS for this site (1 year)
		Strict-Transport-Security "max-age=31536000"
		# Only load scripts, data and images from this site. The login token lives in localStorage,
		# so blocking injected/third-party scripts is the main defence against it being stolen.
		# 'unsafe-inline' styles: react-toastify injects its stylesheet at runtime.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API
	handle /graphql* {
		reverse_proxy api:3000
	}
	handle /up {
		reverse_proxy api:3000
	}

	# React app: serve the file if it exists, otherwise index.html so client-side routes work
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Hashed assets never change; let browsers cache them for a long time
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
