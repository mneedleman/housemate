# APP_DOMAIN comes from /opt/housemate/.env (e.g. housemate.example.com).
# Caddy fetches and renews the HTTPS certificate automatically.
{$APP_DOMAIN} {
	encode zstd gzip

	# API
	handle /graphql* {
		reverse_proxy api:3000
	}
	handle /up {
		reverse_proxy api:3000
	}

	# React app: serve the file if it exists, otherwise index.html so client-side routes work
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Hashed assets never change; let browsers cache them for a long time
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
